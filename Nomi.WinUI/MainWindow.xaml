<Window
    x:Class="Nomi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nomi">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandInvoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="ViewShortcut" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="ViewShortcut" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="ViewShortcut" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="ViewShortcut" />
            <KeyboardAccelerator Key="Number1" Modifiers="Menu" Invoked="ActionShortcut" />
            <KeyboardAccelerator Key="Number2" Modifiers="Menu" Invoked="ActionShortcut" />
            <KeyboardAccelerator Key="Number3" Modifiers="Menu" Invoked="ActionShortcut" />
            <KeyboardAccelerator Key="Number4" Modifiers="Menu" Invoked="ActionShortcut" />
            <KeyboardAccelerator Key="Number5" Modifiers="Menu" Invoked="ActionShortcut" />
            <KeyboardAccelerator Key="Number6" Modifiers="Menu" Invoked="ActionShortcut" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTaskInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ambient light -->
        <Grid x:Name="Ambient" Grid.RowSpan="2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Ellipse x:Name="HaloWarm" Width="760" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-220,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{ThemeResource NomiHaloWarm}" Offset="0" />
                        <GradientStop Color="{ThemeResource NomiHaloClear}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="HaloSand" Width="820" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-260,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{ThemeResource NomiHaloSand}" Offset="0" />
                        <GradientStop Color="{ThemeResource NomiHaloClear}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="HaloSage" Width="900" Height="640" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,-120,-300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{ThemeResource NomiHaloSage}" Offset="0" />
                        <GradientStop Color="{ThemeResource NomiHaloClear}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Border Background="{ThemeResource NomiCanvasVeil}" Opacity="0.35" />
        </Grid>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Padding="18,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Width="20" Height="20" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock FontSize="15" FontWeight="SemiBold" CharacterSpacing="-15" FontFamily="{StaticResource NomiDisplay}"
                           Foreground="{ThemeResource NomiInk}" VerticalAlignment="Center">
                    <Run Text="nomi" /><Run Text="." Foreground="{ThemeResource NomiAccent}" />
                </TextBlock>
                <TextBlock x:Name="Tagline" FontSize="12" Foreground="{ThemeResource NomiInk3}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="FocusPill" Style="{StaticResource NomiChip}" Visibility="Collapsed" Click="FocusPillClicked" CornerRadius="999"
                        Background="{ThemeResource NomiAccentSoft}" BorderBrush="{ThemeResource NomiAccent}" Padding="10,3" MinHeight="26">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="FocusPillDot" Width="7" Height="7" Fill="{ThemeResource NomiAccent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FocusPillText" FontSize="11.5" Foreground="{ThemeResource NomiInk}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Border x:Name="EnginePill" Style="{StaticResource NomiPill}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="EnginePillDot" Width="6" Height="6" Fill="{ThemeResource NomiInk3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="EnginePillText" FontSize="11.5" Foreground="{ThemeResource NomiInk2}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="LanguageSwitch" Style="{StaticResource NomiPill}" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <ToggleButton x:Name="FrenchToggle" Content="FR" Tag="fr" Style="{StaticResource NomiSegment}" CornerRadius="999" MinHeight="22" Padding="8,1" FontSize="11.5" Click="LanguageToggled" />
                        <ToggleButton x:Name="EnglishToggle" Content="EN" Tag="en" Style="{StaticResource NomiSegment}" CornerRadius="999" MinHeight="22" Padding="8,1" FontSize="11.5" Click="LanguageToggled" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid x:Name="Body" Grid.Row="1" Padding="14,4,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="212" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AsideColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="Aside.Visibility" Value="Collapsed" />
                            <Setter Target="AsideColumn.Width" Value="0" />
                            <Setter Target="MainArea.Margin" Value="14,0,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1180" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="Aside.Visibility" Value="Visible" />
                            <Setter Target="AsideColumn.Width" Value="300" />
                            <Setter Target="MainArea.Margin" Value="14,0,14,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Style="{StaticResource NomiCard}" CornerRadius="22" Padding="10,12"
                    Shadow="{StaticResource NomiShadow}" Translation="0,0,12">
                <Grid RowSpacing="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="WorkTitle" Style="{StaticResource NomiCardTitle}" Margin="10,4,0,6" />
                    <StackPanel x:Name="NavList" Grid.Row="1" Spacing="2" />
                    <TextBlock x:Name="ActionsTitle" Grid.Row="2" Style="{StaticResource NomiCardTitle}" Margin="10,16,0,6" />
                    <ScrollViewer Grid.Row="3" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="RailActions" Spacing="1" />
                    </ScrollViewer>
                    <StackPanel x:Name="RailFooter" Grid.Row="4" Spacing="1" Padding="0,6,0,8" />
                    <Border Grid.Row="5" Style="{StaticResource NomiInner}" CornerRadius="14" Padding="10">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="RailNoteTitle" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NomiInk2}" TextWrapping="Wrap" />
                            <TextBlock x:Name="RailNoteText" FontSize="12" Foreground="{ThemeResource NomiInk3}" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main -->
            <Grid x:Name="MainArea" Grid.Column="1" Margin="14,0,14,0">
                <Grid x:Name="Views" Margin="0,6,0,76">
                <Grid x:Name="Workspace" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,4,6,4" Spacing="4">
                        <TextBlock x:Name="ActionDescription" FontSize="13" Foreground="{ThemeResource NomiInk3}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="ActionTitle" FontSize="28" FontWeight="SemiBold" CharacterSpacing="-20" FontFamily="{StaticResource NomiDisplay}"
                                       Foreground="{ThemeResource NomiInk}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                            <Border x:Name="ContextTag" Style="{StaticResource NomiPill}" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="ContextTagText" FontSize="12" Foreground="{ThemeResource NomiInk2}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Composer -->
                    <Border x:Name="Composer" Grid.Row="1" Style="{StaticResource NomiCard}" CornerRadius="22" Padding="14"
                            Shadow="{StaticResource NomiShadow}" Translation="0,0,10">
                        <StackPanel Spacing="8">
                            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ActionChips" Orientation="Horizontal" Spacing="6" AutomationProperties.Name="Action" />
                            </ScrollViewer>
                            <TextBox x:Name="RequestBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxLength="6000" MinHeight="74" MaxHeight="220" FontSize="16"
                                     BorderThickness="0" Background="Transparent" Padding="4,8,4,6"
                                     Foreground="{ThemeResource NomiInk}" TextChanged="RequestChanged"
                                     GotFocus="ComposerFocused" LostFocus="ComposerUnfocused">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AttachButton" Style="{StaticResource NomiChip}" Click="AttachClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                        <TextBlock x:Name="AttachLabel" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton x:Name="ReasoningToggle" Grid.Column="1" Style="{StaticResource NomiChipToggle}" CornerRadius="12" Click="ReasoningToggled" MinHeight="32">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEA80;" FontSize="12" />
                                        <TextBlock x:Name="ReasoningLabel" />
                                    </StackPanel>
                                </ToggleButton>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                        <StackPanel x:Name="DocumentChips" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="DocumentFormats" FontSize="11.5" Foreground="{ThemeResource NomiInk3}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                                </Grid>
                                <DropDownButton x:Name="ContextChip" Grid.Column="3" Style="{StaticResource NomiChip}" CornerRadius="999" Padding="11,4" MinHeight="30" />
                                <Border Grid.Column="4" Style="{StaticResource NomiPill}" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="FormatLabel" Visibility="Collapsed" />
                                        <ToggleButton x:Name="StepsToggle" Style="{StaticResource NomiSegment}" CornerRadius="999" MinHeight="24" Padding="9,1" Click="FormatToggled" />
                                        <ToggleButton x:Name="SummaryToggle" Style="{StaticResource NomiSegment}" CornerRadius="999" MinHeight="24" Padding="9,1" Click="FormatToggled" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="ExampleButton" Grid.Column="5" Style="{StaticResource NomiGhost}" Padding="9,6" FontSize="12.5" Click="ExampleClicked" />
                                <Button x:Name="StopButton" Grid.Column="6" Style="{StaticResource NomiChip}" Click="StopClicked" Visibility="Collapsed" />
                                <Button x:Name="LaunchButton" Grid.Column="7" Style="{StaticResource NomiPrimary}" Click="LaunchClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="LaunchLabel" VerticalAlignment="Center" />
                                        <Border BorderBrush="#59FFFFFF" Background="#2EFFFFFF" BorderThickness="1" CornerRadius="6" Padding="5,0">
                                            <TextBlock Text="Ctrl ↵" FontFamily="{StaticResource NomiMono}" FontSize="10.5" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12.5" Foreground="{ThemeResource NomiInk2}"
                               TextWrapping="Wrap" Margin="8,-2,8,0" />

                    <!-- Result -->
                    <Border x:Name="ResultPanel" Grid.Row="3" Style="{StaticResource NomiCard}" CornerRadius="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ResultHead" Padding="20,16,20,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource NomiOk}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ResultTag" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource NomiOk}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ResultMeta" FontSize="12" Foreground="{ThemeResource NomiInk3}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ResultBody" Padding="20,10,20,12" MaxWidth="760" HorizontalAlignment="Left" Spacing="0" />
                            </ScrollViewer>
                            <ProgressBar x:Name="WorkingBar" Grid.RowSpan="3" VerticalAlignment="Top" IsIndeterminate="False"
                                         Foreground="{ThemeResource NomiAccent}" Background="Transparent" Margin="16,0,16,0"
                                         Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel x:Name="WorkingState" Grid.Row="1" Padding="22,22,22,20" Spacing="12" MaxWidth="760"
                                        HorizontalAlignment="Stretch" Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing x:Name="WorkingRing" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource NomiAccent}" />
                                    <TextBlock x:Name="WorkingTitle" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource NomiInk}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WorkingMeta" Grid.Column="2" FontFamily="{StaticResource NomiMono}" FontSize="11.5"
                                               Foreground="{ThemeResource NomiInk3}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="WorkingText" Style="{StaticResource NomiMuted}" Margin="26,-6,0,0" />
                                <StackPanel x:Name="Skeleton" Spacing="11" Margin="26,10,0,0" AutomationProperties.AccessibilityView="Raw">
                                    <Border Height="11" CornerRadius="6" Background="{ThemeResource NomiGlassSoft}" Margin="0,0,40,0" />
                                    <Border Height="11" CornerRadius="6" Background="{ThemeResource NomiGlassSoft}" Margin="0,0,110,0" />
                                    <Border Height="11" CornerRadius="6" Background="{ThemeResource NomiGlassSoft}" Margin="0,0,70,0" />
                                    <Border Height="11" CornerRadius="6" Background="{ThemeResource NomiGlassSoft}" Margin="0,0,220,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        MaxWidth="440" Spacing="8" Padding="24">
                                <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"
                                           Foreground="{ThemeResource NomiInk}" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyText" FontSize="13.5" TextAlignment="Center" Foreground="{ThemeResource NomiInk2}" TextWrapping="Wrap" />
                                <Button x:Name="EmptyAction" Style="{StaticResource NomiPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="PrepareClicked" />
                            </StackPanel>
                            <StackPanel x:Name="ResultFoot" Grid.Row="2" Padding="20,4,20,14" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CopyButton" Style="{StaticResource NomiChip}" Click="CopyClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="12" />
                                            <TextBlock x:Name="CopyLabel" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RetryButton" Style="{StaticResource NomiChip}" Click="RetryClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            <TextBlock x:Name="RetryLabel" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TaskButton" Style="{StaticResource NomiPrimary}" Padding="12,6" MinHeight="32" FontSize="12.5" Click="TaskClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE9D5;" FontSize="12" />
                                            <TextBlock x:Name="TaskLabel" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EditButton" Style="{StaticResource NomiGhost}" Padding="10,6" FontSize="12.5" Click="EditClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            <TextBlock x:Name="EditLabel" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="ResultFootText" FontSize="11.5" Foreground="{ThemeResource NomiInk3}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SpacesPanel" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SpacesBody" Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Padding="4,4,4,8" />
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsBody" Spacing="14" MaxWidth="620" HorizontalAlignment="Left" Padding="4,4,4,8" />
                </ScrollViewer>
                <ScrollViewer x:Name="TodayPanel" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TodayBody" Spacing="14" HorizontalAlignment="Stretch" Padding="4,0,4,10" />
                </ScrollViewer>
                <Grid x:Name="BoardPanel" Visibility="Collapsed" RowSpacing="14" Padding="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="BoardHeader" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="BoardColumns" ColumnSpacing="12" MinWidth="640" />
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="FocusPanel" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FocusBody" Spacing="12" HorizontalAlignment="Stretch" Padding="4,0,4,10" />
                </ScrollViewer>
                </Grid>

                <!-- Floating command bar -->
                <Button x:Name="CommandButton" Click="OpenCommandClicked" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        MaxWidth="640" Height="58" CornerRadius="20" Padding="16,0,12,0" BorderThickness="1"
                        Background="{ThemeResource NomiGlassStrong}" BorderBrush="{ThemeResource NomiGlassEdge}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                        Shadow="{StaticResource NomiShadow}" Translation="0,0,24">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE945;" FontSize="17" Foreground="{ThemeResource NomiInk3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CommandText" Grid.Column="1" FontSize="14.5" Foreground="{ThemeResource NomiInk3}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Style="{StaticResource NomiKbd}">
                            <TextBlock Text="Ctrl K" Style="{StaticResource NomiKbdText}" />
                        </Border>
                    </Grid>
                </Button>
            </Grid>

            <!-- Companion -->
            <Border x:Name="Aside" Grid.Column="2" Style="{StaticResource NomiCard}" CornerRadius="22" Padding="14"
                    Shadow="{StaticResource NomiShadow}" Translation="0,0,12">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="12">
                        <Grid x:Name="CompanionCard" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="Orb" Width="34" Height="34" Margin="4" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                <Ellipse Width="42" Height="42" Margin="-4" Fill="{ThemeResource NomiAccentSoft}" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.6" RadiusY="0.6">
                                            <GradientStop Color="{ThemeResource NomiOrbLight}" Offset="0" />
                                            <GradientStop Color="{ThemeResource NomiOrbDeep}" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="14" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6,0,0" Fill="#88FFFFFF" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="CompanionTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource NomiInk}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CompanionState" FontSize="12" Foreground="{ThemeResource NomiInk3}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="CompanionBody" Spacing="12" />
                        <Border x:Name="EngineCard" Style="{StaticResource NomiInner}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock x:Name="EngineTitle" Style="{StaticResource NomiCardTitle}" />
                                    <Border HorizontalAlignment="Right" Style="{StaticResource NomiKbd}">
                                        <TextBlock Text="CPU" Style="{StaticResource NomiKbdText}" />
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
                                    <Ellipse x:Name="EngineDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource NomiInk3}" />
                                    <TextBlock x:Name="EngineStatus" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource NomiInk}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="EngineDetail" Style="{StaticResource NomiMuted}" />
                                <ProgressBar x:Name="EngineProgress" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{ThemeResource NomiAccent}" />
                                <TextBlock x:Name="EngineMessage" Style="{StaticResource NomiMuted}" Foreground="{ThemeResource NomiInk2}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="PrepareButton" Style="{StaticResource NomiPrimary}" Padding="12,5" MinHeight="30" FontSize="12" Click="PrepareClicked" />
                                    <Button x:Name="PrepareCancel" Style="{StaticResource NomiChip}" Visibility="Collapsed" Click="PrepareCancelClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DocumentsCard" Style="{StaticResource NomiInner}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DocumentsTitle" Style="{StaticResource NomiCardTitle}" />
                                <StackPanel x:Name="DocumentList" Spacing="8" />
                                <TextBlock x:Name="DocumentStatus" Style="{StaticResource NomiMuted}" Foreground="{ThemeResource NomiInk2}" />
                                <TextBlock x:Name="DocumentNote" Style="{StaticResource NomiMuted}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="HistoryCard" Style="{StaticResource NomiInner}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock x:Name="HistoryTitle" Style="{StaticResource NomiCardTitle}" VerticalAlignment="Center" />
                                    <Button x:Name="HistoryClear" Style="{StaticResource NomiGhost}" HorizontalAlignment="Right" Padding="8,2"
                                            MinHeight="24" FontSize="11.5" Margin="0,-4,-6,-4" Click="HistoryClearClicked" />
                                </Grid>
                                <StackPanel x:Name="HistoryList" Spacing="4" />
                                <TextBlock x:Name="HistoryNote" Style="{StaticResource NomiMuted}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ExamplesCard" Style="{StaticResource NomiInner}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="ExamplesTitle" Style="{StaticResource NomiCardTitle}" />
                                <StackPanel x:Name="ExampleList" Spacing="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Task sheet -->
        <Grid x:Name="SheetOverlay" Grid.RowSpan="2" Background="{ThemeResource NomiScrim}" Visibility="Collapsed" Tapped="SheetScrimTapped">
            <Border x:Name="SheetCard" Style="{StaticResource NomiCard}" Background="{ThemeResource NomiGlassStrong}" Width="440"
                    HorizontalAlignment="Right" Margin="0,54,14,14" Shadow="{StaticResource NomiShadow}" Translation="0,0,40"
                    Tapped="SheetCardTapped" KeyDown="SheetKeyDown">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SheetBody" Spacing="14" Padding="22,20,22,22" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.RowSpan="2" Style="{StaticResource NomiCard}" Background="{ThemeResource NomiGlassStrong}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="16,8,8,8"
                Shadow="{StaticResource NomiShadow}" Translation="0,0,36" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource NomiSage}" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" FontSize="13" Foreground="{ThemeResource NomiInk}" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
                <Button x:Name="ToastAction" Style="{StaticResource NomiChip}" Click="ToastActionClicked" />
            </StackPanel>
        </Border>

        <!-- Command palette -->
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Background="{ThemeResource NomiScrim}" Visibility="Collapsed"
              Tapped="PaletteScrimTapped">
            <Border x:Name="PaletteCard" Style="{StaticResource NomiCard}" Background="{ThemeResource NomiGlassStrong}" CornerRadius="24"
                    Width="620" MaxWidth="1200" VerticalAlignment="Top" Margin="0,110,0,0"
                    Shadow="{StaticResource NomiShadow}" Translation="0,0,32"
                    Tapped="PaletteCardTapped">
                <StackPanel>
                    <Grid Padding="14,10" ColumnSpacing="10" BorderBrush="{ThemeResource NomiLine}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource NomiInk3}" />
                        <TextBox x:Name="PaletteSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="16"
                                 Padding="0,6" TextChanged="PaletteFilter" KeyDown="PaletteKeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Border Grid.Column="2" Style="{StaticResource NomiKbd}">
                            <TextBlock Text="Esc" Style="{StaticResource NomiKbdText}" />
                        </Border>
                    </Grid>
                    <ListView x:Name="PaletteResults" MaxHeight="380" Padding="6" IsItemClickEnabled="True"
                              SelectionMode="Single" ItemClick="PaletteItemClick" KeyDown="PaletteKeyDown" />
                    <TextBlock x:Name="PaletteEmpty" Style="{StaticResource NomiMuted}" Padding="16,12" Visibility="Collapsed" />
                    <TextBlock x:Name="PaletteHelp" Style="{StaticResource NomiMuted}" Padding="14,8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Launch splash -->
        <Grid x:Name="Splash" Grid.RowSpan="2" Background="{ThemeResource NomiCanvas}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image x:Name="SplashLogo" Width="72" Height="72" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="nomi." FontSize="28" FontWeight="SemiBold" CharacterSpacing="-20" HorizontalAlignment="Center"
                           Foreground="{ThemeResource NomiInk}" Margin="0,6,0,0" />
                <TextBlock x:Name="SplashTagline" FontSize="13" Foreground="{ThemeResource NomiInk3}" HorizontalAlignment="Center" />
                <ProgressBar x:Name="SplashProgress" Width="120" IsIndeterminate="True" Foreground="{ThemeResource NomiAccent}"
                             Background="Transparent" Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
