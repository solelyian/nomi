<Application
    x:Class="Nomi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NomiCanvas" Color="#ECE6DE" />
                        <AcrylicBrush x:Key="NomiGlass" TintColor="#FFFFFF" TintOpacity="0.55" TintLuminosityOpacity="0.82" FallbackColor="#F8F6F3" />
                        <AcrylicBrush x:Key="NomiGlassStrong" TintColor="#FFFFFF" TintOpacity="0.72" TintLuminosityOpacity="0.9" FallbackColor="#FFFFFF" />
                        <SolidColorBrush x:Key="NomiGlassSoft" Color="#8CFFFFFF" />
                        <SolidColorBrush x:Key="NomiCanvasVeil" Color="#80ECE6DE" />
                        <LinearGradientBrush x:Key="NomiGlassEdge" StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#66D7D0C7" Offset="0.55" />
                            <GradientStop Color="#99CFC8BF" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="NomiSheen" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#80FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.38" />
                        </LinearGradientBrush>
                        <Color x:Key="NomiHaloWarm">#BFE7A98B</Color>
                        <Color x:Key="NomiHaloSand">#A6E9CFA0</Color>
                        <Color x:Key="NomiHaloSage">#8CB9CDB5</Color>
                        <Color x:Key="NomiHaloClear">#00ECE6DE</Color>
                        <Color x:Key="NomiOrbLight">#FFE07A57</Color>
                        <Color x:Key="NomiOrbDeep">#FFB4482B</Color>
                        <SolidColorBrush x:Key="NomiSage" Color="#46684D" />
                        <SolidColorBrush x:Key="NomiSageSoft" Color="#E1EAE0" />
                        <SolidColorBrush x:Key="NomiSand" Color="#7F6136" />
                        <SolidColorBrush x:Key="NomiSandSoft" Color="#F1E7D6" />
                        <SolidColorBrush x:Key="NomiDrop" Color="#1FB4482B" />
                        <SolidColorBrush x:Key="NomiSurface" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="NomiSurface2" Color="#F7F5F2" />
                        <SolidColorBrush x:Key="NomiLine" Color="#E2DDD6" />
                        <SolidColorBrush x:Key="NomiLineStrong" Color="#CFC8BF" />
                        <SolidColorBrush x:Key="NomiInk" Color="#171512" />
                        <SolidColorBrush x:Key="NomiInk2" Color="#4D4741" />
                        <SolidColorBrush x:Key="NomiInk3" Color="#857D74" />
                        <SolidColorBrush x:Key="NomiAccent" Color="#B4482B" />
                        <SolidColorBrush x:Key="NomiAccentInk" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="NomiAccentSoft" Color="#F6E6DF" />
                        <SolidColorBrush x:Key="NomiOk" Color="#2F7D4F" />
                        <SolidColorBrush x:Key="NomiScrim" Color="#66171512" />
                        <SolidColorBrush x:Key="NomiHover" Color="#F1EDE8" />
                        <SolidColorBrush x:Key="NomiPressed" Color="#E8E2DB" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1EDE8" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E8E2DB" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CFC8BF" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CFC8BF" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#171512" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#171512" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#F1EDE8" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#E8E2DB" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#CFC8BF" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#CFC8BF" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#171512" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#171512" />
                        <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#B4482B" />
                        <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#171512" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#171512" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2B2824" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#2B2824" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3D3934" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#3D3934" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NomiCanvas" Color="#0F0E0D" />
                        <AcrylicBrush x:Key="NomiGlass" TintColor="#1C1B19" TintOpacity="0.5" TintLuminosityOpacity="0.78" FallbackColor="#1F1E1C" />
                        <AcrylicBrush x:Key="NomiGlassStrong" TintColor="#242320" TintOpacity="0.66" TintLuminosityOpacity="0.86" FallbackColor="#262523" />
                        <SolidColorBrush x:Key="NomiGlassSoft" Color="#14FFFFFF" />
                        <SolidColorBrush x:Key="NomiCanvasVeil" Color="#990F0E0D" />
                        <LinearGradientBrush x:Key="NomiGlassEdge" StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop Color="#40FFFFFF" Offset="0" />
                            <GradientStop Color="#14FFFFFF" Offset="0.5" />
                            <GradientStop Color="#0DFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="NomiSheen" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#17FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.38" />
                        </LinearGradientBrush>
                        <Color x:Key="NomiHaloWarm">#66B4482B</Color>
                        <Color x:Key="NomiHaloSand">#4D8A6A3C</Color>
                        <Color x:Key="NomiHaloSage">#4D4F6E56</Color>
                        <Color x:Key="NomiHaloClear">#000F0E0D</Color>
                        <Color x:Key="NomiOrbLight">#FFF0A07F</Color>
                        <Color x:Key="NomiOrbDeep">#FFE8825F</Color>
                        <SolidColorBrush x:Key="NomiSage" Color="#9CC6A3" />
                        <SolidColorBrush x:Key="NomiSageSoft" Color="#22302A" />
                        <SolidColorBrush x:Key="NomiSand" Color="#DDBE8C" />
                        <SolidColorBrush x:Key="NomiSandSoft" Color="#33291C" />
                        <SolidColorBrush x:Key="NomiDrop" Color="#26E8825F" />
                        <SolidColorBrush x:Key="NomiSurface" Color="#1F1E1C" />
                        <SolidColorBrush x:Key="NomiSurface2" Color="#262523" />
                        <SolidColorBrush x:Key="NomiLine" Color="#2F2D2A" />
                        <SolidColorBrush x:Key="NomiLineStrong" Color="#3D3A36" />
                        <SolidColorBrush x:Key="NomiInk" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="NomiInk2" Color="#C9C3BB" />
                        <SolidColorBrush x:Key="NomiInk3" Color="#8D867D" />
                        <SolidColorBrush x:Key="NomiAccent" Color="#E8825F" />
                        <SolidColorBrush x:Key="NomiAccentInk" Color="#1A1210" />
                        <SolidColorBrush x:Key="NomiAccentSoft" Color="#3A2A23" />
                        <SolidColorBrush x:Key="NomiOk" Color="#6FBF8A" />
                        <SolidColorBrush x:Key="NomiScrim" Color="#99000000" />
                        <SolidColorBrush x:Key="NomiHover" Color="#2A2927" />
                        <SolidColorBrush x:Key="NomiPressed" Color="#343230" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2927" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#343230" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4A4641" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4A4641" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2A2927" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#343230" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#4A4641" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#4A4641" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#E8825F" />
                        <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#111110" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#F2EFEA" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#DDD8D1" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#DDD8D1" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C9C3BB" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#C9C3BB" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#171512" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#171512" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#171512" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="NomiCanvas" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiGlass" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiGlassStrong" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiGlassSoft" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiCanvasVeil" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiGlassEdge" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiSheen" Color="Transparent" />
                        <Color x:Key="NomiHaloWarm">#00000000</Color>
                        <Color x:Key="NomiHaloSand">#00000000</Color>
                        <Color x:Key="NomiHaloSage">#00000000</Color>
                        <Color x:Key="NomiHaloClear">#00000000</Color>
                        <Color x:Key="NomiOrbLight">#00000000</Color>
                        <Color x:Key="NomiOrbDeep">#00000000</Color>
                        <SolidColorBrush x:Key="NomiSage" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiSageSoft" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiSand" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiSandSoft" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiDrop" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="NomiSurface" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiSurface2" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiLine" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiLineStrong" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiInk" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiInk2" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiInk3" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiAccent" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="NomiAccentInk" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="NomiAccentSoft" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiOk" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="NomiScrim" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NomiHover" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="NomiPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="NomiMono">Cascadia Mono, Consolas</FontFamily>
            <ThemeShadow x:Key="NomiShadow" />
            <FontFamily x:Key="NomiDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

            <TransitionCollection x:Key="NomiEntrance">
                <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
            </TransitionCollection>
            <TransitionCollection x:Key="NomiListTransitions">
                <AddDeleteThemeTransition />
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>

            <Style x:Key="NomiCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NomiGlass}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <Style x:Key="NomiInner" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NomiGlassSoft}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,12" />
            </Style>

            <Style x:Key="NomiPill" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NomiGlassSoft}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="NomiLane" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NomiGlassSoft}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="NomiTaskCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource NomiGlassStrong}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,11" />
            </Style>

            <Style x:Key="NomiNav" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk2}" />
            </Style>

            <Style x:Key="NomiCardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="90" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk3}" />
            </Style>

            <Style x:Key="NomiMuted" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk3}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="NomiKbd" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource NomiLineStrong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="Background" Value="{ThemeResource NomiSurface2}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="NomiKbdText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource NomiMono}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk2}" />
            </Style>

            <Style x:Key="NomiChip" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource NomiGlassStrong}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk}" />
            </Style>

            <Style x:Key="NomiGhost" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk2}" />
            </Style>

            <Style x:Key="NomiPrimary" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource NomiAccent}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiAccent}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource NomiAccentInk}" />
            </Style>

            <Style x:Key="NomiRail" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="0,10,0,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk2}" />
            </Style>

            <Style x:Key="NomiSegment" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk2}" />
            </Style>

            <Style x:Key="NomiChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource NomiGlassSoft}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk}" />
            </Style>

            <Style x:Key="NomiExample" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource NomiGlassSoft}" />
                <Setter Property="BorderBrush" Value="{ThemeResource NomiGlassEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{ThemeResource NomiInk}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
