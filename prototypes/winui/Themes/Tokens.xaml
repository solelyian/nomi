<?xml version="1.0" encoding="utf-8"?>
<!-- Design system Nomi v4 — « verre chaud ». Voir docs/refonte/dossier.md §7. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    
    <ResourceDictionary.ThemeDictionaries>
        <!-- ============================== CLAIR ============================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="CanvasColor">#ECE6DE</Color>
            <Color x:Key="InkColor">#211D19</Color>
            <Color x:Key="InkSoftColor">#6B6158</Color>
            <Color x:Key="InkFaintColor">#9B9187</Color>
            <Color x:Key="AccentColor">#B4482B</Color>
            <Color x:Key="AccentInkColor">#8C351F</Color>
            <Color x:Key="AccentSoftColor">#33B4482B</Color>
            <Color x:Key="CardColor">#C2FFFFFF</Color>
            <Color x:Key="CardHoverColor">#E0FFFFFF</Color>
            <Color x:Key="StrokeColor">#1F211D19</Color>
            <Color x:Key="StrokeStrongColor">#40211D19</Color>
            <Color x:Key="OkColor">#3E7C4F</Color>
            <Color x:Key="OkSoftColor">#263E7C4F</Color>
            <Color x:Key="WarnColor">#B07B22</Color>
            <Color x:Key="WarnSoftColor">#26B07B22</Color>
            <Color x:Key="ErrColor">#B4482B</Color>
            <Color x:Key="ErrSoftColor">#26B4482B</Color>
            <Color x:Key="InfoColor">#4A6E8C</Color>
            <Color x:Key="InfoSoftColor">#264A6E8C</Color>
            <Color x:Key="NavSelColor">#1A211D19</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}"/>
            <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource InkFaintColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}"/>
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}"/>
            <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
            <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}"/>
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
            <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
            <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}"/>
            <SolidColorBrush x:Key="ErrSoftBrush" Color="{StaticResource ErrSoftColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
            <SolidColorBrush x:Key="NavSelBrush" Color="{StaticResource NavSelColor}"/>
        </ResourceDictionary>
        <!-- ============================== SOMBRE ============================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="CanvasColor">#0F0E0D</Color>
            <Color x:Key="InkColor">#F0EBE4</Color>
            <Color x:Key="InkSoftColor">#ABA195</Color>
            <Color x:Key="InkFaintColor">#7A7166</Color>
            <Color x:Key="AccentColor">#E8825F</Color>
            <Color x:Key="AccentInkColor">#F2A37F</Color>
            <Color x:Key="AccentSoftColor">#33E8825F</Color>
            <Color x:Key="CardColor">#2EFFFFFF</Color>
            <Color x:Key="CardHoverColor">#40FFFFFF</Color>
            <Color x:Key="StrokeColor">#26F0EBE4</Color>
            <Color x:Key="StrokeStrongColor">#4DF0EBE4</Color>
            <Color x:Key="OkColor">#7FBA8E</Color>
            <Color x:Key="OkSoftColor">#2E7FBA8E</Color>
            <Color x:Key="WarnColor">#D9A54A</Color>
            <Color x:Key="WarnSoftColor">#2ED9A54A</Color>
            <Color x:Key="ErrColor">#E8825F</Color>
            <Color x:Key="ErrSoftColor">#2EE8825F</Color>
            <Color x:Key="InfoColor">#7FA3BF</Color>
            <Color x:Key="InfoSoftColor">#2E7FA3BF</Color>
            <Color x:Key="NavSelColor">#26F0EBE4</Color>
            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}"/>
            <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource InkFaintColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}"/>
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}"/>
            <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
            <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}"/>
            <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
            <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
            <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}"/>
            <SolidColorBrush x:Key="ErrSoftBrush" Color="{StaticResource ErrSoftColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
            <SolidColorBrush x:Key="NavSelBrush" Color="{StaticResource NavSelColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============ Styles de composants (design system v4) ============ -->

    <!-- Carte verre -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- En-tête de carte -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
    </Style>

    <!-- Texte courant -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="OverlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource InkFaintBrush}"/>
        <Setter Property="CharacterSpacing" Value="120"/>
    </Style>

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegibleMono.ttf#Atkinson Hyperlegible Mono"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
    </Style>

    <!-- Bouton principal terracotta -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#FFF7F2"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Pastille (Pill — toujours via Capsule, jamais CornerRadius=999) -->
    <Style x:Key="PillBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSoftBrush}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentInkBrush}"/>
    </Style>

    <!-- Entrée de navigation latérale -->
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource InkSoftBrush}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="NavItemSelected" TargetType="Button" BasedOn="{StaticResource NavItem}">
        <Setter Property="Background" Value="{ThemeResource NavSelBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
