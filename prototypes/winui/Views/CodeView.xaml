<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nomi.Prototype.WinUI.Views.CodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Nomi.Prototype.WinUI.Services">
    <Grid Padding="8" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/><ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- Éditeur -->
        <Border Style="{StaticResource GlassCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Padding="14,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="facture.ts" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Button x:Name="AnalyzeButton" Grid.Column="1" Style="{StaticResource AccentButton}"
                            Content="Analyser avec Nomi" Click="OnAnalyze"/>
                </Grid>
                <Border Grid.Row="1" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="Editor" Style="{StaticResource CodeText}" TextWrapping="NoWrap"
                                   Text="{x:Bind services:DemoData.InvoiceSource, Mode=OneTime}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Résultats -->
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel x:Name="EmptyState" Spacing="10">
                    <TextBlock Text="RELECTURE" Style="{StaticResource OverlineText}"/>
                    <TextBlock Text="Lancez l'analyse : Nomi relit le fichier et propose des corrections — rien n'est appliqué sans vous."
                               Style="{StaticResource CaptionText}"/>
                    <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Left">
                        <TextBlock Text="IA simulée — aucun modèle chargé" Style="{StaticResource PillText}"/>
                    </Border>
                </StackPanel>
                <ProgressRing x:Name="Spinner" IsActive="False" Visibility="Collapsed" Width="28" Height="28"
                              Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Left"/>
                <StackPanel x:Name="DiagList" Spacing="8"/>
                <Border x:Name="DiffCard" Style="{StaticResource GlassCard}" Visibility="Collapsed" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CORRECTIF PROPOSÉ — NON APPLIQUÉ" Style="{StaticResource OverlineText}"/>
                        <Border Background="{ThemeResource ErrSoftBrush}" CornerRadius="8" Padding="10">
                            <TextBlock x:Name="DiffBefore" Style="{StaticResource CodeText}" Foreground="{ThemeResource ErrBrush}"/>
                        </Border>
                        <Border Background="{ThemeResource OkSoftBrush}" CornerRadius="8" Padding="10">
                            <TextBlock x:Name="DiffAfter" Style="{StaticResource CodeText}" Foreground="{ThemeResource OkBrush}"/>
                        </Border>
                        <TextBlock x:Name="Explanation" Style="{StaticResource CaptionText}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButton}" Content="Appliquer" Click="OnApply"/>
                            <Button Style="{StaticResource GhostButton}" Content="Écarter" Click="OnDismiss"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
