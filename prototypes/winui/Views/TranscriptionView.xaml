<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nomi.Prototype.WinUI.Views.TranscriptionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="8" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/><ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource GlassCard}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Analyse — séance 8" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                       Text="Enregistrement local — rien ne quitte la machine"/>
                        </StackPanel>
                        <TextBlock x:Name="Timer" Grid.Column="1" Text="00:00" VerticalAlignment="Center"
                                   FontFamily="ms-appx:///Assets/Fonts/AtkinsonHyperlegibleMono.ttf#Atkinson Hyperlegible Mono" FontSize="18" Foreground="{ThemeResource AccentInkBrush}"/>
                        <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource AccentButton}"
                                Content="Démarrer la transcription" Click="OnStart"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCard}" Padding="10">
                    <StackPanel x:Name="Transcript" Spacing="4">
                        <TextBlock Style="{StaticResource CaptionText}" Padding="8"
                                   Text="La transcription s'affiche ici au fil de l'écoute. « [inaudible] » et les passages incertains sont marqués, pas inventés."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Panneau « En direct » -->
        <Border Grid.Column="1" Style="{StaticResource GlassCard}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="EN DIRECT" Style="{StaticResource OverlineText}"/>
                    <Border Style="{StaticResource PillBorder}">
                        <TextBlock Text="notes IA simulées" Style="{StaticResource PillText}"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="LiveNotes" Spacing="8">
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Points clés, définitions et questions relevés pendant l'écoute."/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
