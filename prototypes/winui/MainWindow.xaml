<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nomi.Prototype.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Nomi.Prototype.WinUI.Services">

    <Grid Background="{ThemeResource CanvasBrush}">
        <!-- Ambiance « verre chaud » : halos terracotta -->
        <Ellipse Width="640" Height="640" Fill="{ThemeResource AccentSoftBrush}" Opacity="0.5"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-320,-260,0"/>
        <Ellipse Width="520" Height="520" Fill="{ThemeResource AccentSoftBrush}" Opacity="0.35"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-240,0,0,-260"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre de titre -->
            <Grid Grid.Row="0" Padding="16,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentBrush}">
                        <TextBlock Text="N" FontFamily="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible" FontWeight="Bold" FontSize="13"
                                   Foreground="#FFF7F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nomi" FontFamily="ms-appx:///Assets/Fonts/AtkinsonHyperlegible-Regular.ttf#Atkinson Hyperlegible" FontWeight="Bold" FontSize="15"
                               Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="DemoBadge" Style="{StaticResource PillBorder}" VerticalAlignment="Center">
                        <TextBlock x:Name="DemoBadgeText" Style="{StaticResource PillText}" Text="maquette — données de démonstration"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggle" Style="{StaticResource GhostButton}" Content="☾"
                            AutomationProperties.Name="Basculer clair/sombre" Click="OnThemeToggle"/>
                    <Button x:Name="LangToggle" Style="{StaticResource GhostButton}" Content="FR"
                            AutomationProperties.Name="Switch language" Click="OnLangToggle"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation latérale en espaces -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="12,4,4,12" Padding="10">
                    <StackPanel x:Name="NavPanel" Spacing="2"/>
                </Border>

                <!-- Contenu -->
                <Frame x:Name="ContentFrame" Grid.Column="1" Margin="8,4,16,12"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
